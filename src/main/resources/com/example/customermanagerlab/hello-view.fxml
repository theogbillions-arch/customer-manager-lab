<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- No fx:controller here: HelloApplication attaches HelloController in code,
     so you do not need to type your package name in this file. -->
<VBox spacing="12" prefWidth="520" prefHeight="480"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Customer Manager" style="-fx-font-size: 22; -fx-font-weight: bold;"/>

    <!-- 1. Form: name field + province list -->
    <GridPane hgap="15" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="80" prefWidth="80"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label fx:id="nameLabel" text="_Name" mnemonicParsing="true"
               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" promptText="e.g. Mary Banda" maxWidth="Infinity"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label fx:id="provinceLabel" text="_Province" mnemonicParsing="true"
               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="provinceBox" promptText="Choose a province" maxWidth="Infinity"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Button text="_Add customer" defaultButton="true" onAction="#onAddCustomer"
                GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <!-- Validation / status message -->
    <Label fx:id="messageLabel" wrapText="true" minHeight="20"/>

    <!-- 3. TableView with name and province columns -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="No customers yet. Add one above."/>
        </placeholder>
        <columns>
            <TableColumn fx:id="colName" text="Name"/>
            <TableColumn fx:id="colProvince" text="Province"/>
        </columns>
    </TableView>

    <!-- 5. Delete with confirmation -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button fx:id="deleteBtn" text="_Delete selected" onAction="#onDeleteCustomer"/>
        <Label fx:id="countLabel"/>
    </HBox>
</VBox>
